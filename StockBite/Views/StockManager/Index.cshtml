@model IEnumerable<StockBite.Models.Product>

@{
    ViewData["Title"] = "Stock Manager - Select Product";
    var products = Model ?? Enumerable.Empty<StockBite.Models.Product>();
    var totalProducts = products.Count();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="page-title">Stock Manager Dashboard</h1>
        <p class="page-subtitle">Compare vendors quickly and process pending procurement decisions.</p>
    </div>
    <a asp-action="PendingOrders" class="btn btn-warning btn-sm">View Pending Orders</a>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-label">Products Available</div>
        <div class="metric-value">@totalProducts</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Primary Action</div>
        <div class="metric-value">Compare</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Order Queue</div>
        <div class="metric-value">Pending</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Panel</div>
        <div class="metric-value">Stock</div>
    </div>
</div>

<div class="card app-card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in products)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Description)</td>
                        <td>
                            <a asp-action="CompareVendors" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Compare Vendors</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
