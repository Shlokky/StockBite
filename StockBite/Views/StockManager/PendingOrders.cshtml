@model IEnumerable<StockBite.Models.Order>

@{
    ViewData["Title"] = "Pending Orders";
    var orderCount = Model?.Count() ?? 0;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Order Tracking</h1>
        <p class="page-subtitle">Review, approve, and mark customer orders as delivered.</p>
    </div>
    <span class="badge text-bg-warning px-3 py-2">Count: @orderCount</span>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-label">Pending</div>
        <div class="metric-value">@Model.Count(x => x.Status == StockBite.Models.OrderStatus.Pending)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Approved</div>
        <div class="metric-value">@Model.Count(x => x.Status == StockBite.Models.OrderStatus.Approved)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Delivered</div>
        <div class="metric-value">@Model.Count(x => x.Status == StockBite.Models.OrderStatus.Delivered)</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">View</div>
        <div class="metric-value">Tracking</div>
    </div>
</div>

<div class="card app-card mb-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 order-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Consumer</th>
                        <th>Buyer</th>
                        <th>Delivery</th>
                        <th>Payment</th>
                        <th>Product</th>
                        <th>Vendor</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Placed</th>
                        <th>Approved</th>
                        <th>Delivered</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="table-cell-wide">@item.Consumer.Name</td>
                            <td class="table-cell-wide">@item.CustomerName</td>
                            <td class="table-cell-wide">@item.DeliveryAddress</td>
                            <td>@item.PaymentMethod</td>
                            <td class="table-cell-wide">@item.Product.Name</td>
                            <td class="table-cell-wide">@item.Vendor.Name</td>
                            <td>@item.Quantity</td>
                            <td>@item.TotalPrice.ToString("C")</td>
                            <td>
                                @if (item.Status == StockBite.Models.OrderStatus.Pending)
                                {
                                    <span class="badge text-bg-warning">Pending</span>
                                }
                                else if (item.Status == StockBite.Models.OrderStatus.Approved)
                                {
                                    <span class="badge text-bg-primary">Approved</span>
                                }
                                else if (item.Status == StockBite.Models.OrderStatus.Delivered)
                                {
                                    <span class="badge text-bg-success">Delivered</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>@item.OrderDate.ToString("g")</td>
                            <td>@(item.ApprovedAt?.ToString("g") ?? "-")</td>
                            <td>@(item.DeliveredAt?.ToString("g") ?? "-")</td>
                            <td class="table-action-cell">
                                @if (item.Status == StockBite.Models.OrderStatus.Pending)
                                {
                                    <form asp-action="ApproveOrder" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                    </form>
                                }
                                else if (item.Status == StockBite.Models.OrderStatus.Approved)
                                {
                                    <form asp-action="MarkDelivered" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-primary">Mark Delivered</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Completed</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (orderCount == 0)
{
    <div class="alert alert-info">No orders found right now.</div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl("/stockHub").build();
        connection.on("ordersUpdated", () => location.reload());
        connection.start().catch(err => console.error(err));
    </script>
}
