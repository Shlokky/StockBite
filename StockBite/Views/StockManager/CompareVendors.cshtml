@model IEnumerable<StockBite.Models.VendorProduct>

@{
    ViewData["Title"] = "Compare Vendors";
    var product = ViewBag.Product as StockBite.Models.Product;
    var bestPrice = Model.Any() ? Model.Min(x => x.Price) : 0;
}

<h1 class="page-title mb-1">Compare Vendors</h1>
<p class="page-subtitle">Product: <strong>@product?.Name</strong></p>

<div class="card app-card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Vendor</th>
                    <th>Price</th>
                    <th>Available Quantity</th>
                    <th>Availability</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="@(item.Price == bestPrice ? "table-success" : "")">
                        <td>@Html.DisplayFor(modelItem => item.Vendor.Name)</td>
                        <td>@item.Price.ToString("C")</td>
                        <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                        <td>
                            @if (item.Quantity > 0)
                            {
                                <span class="badge text-bg-success">In Stock</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Out of Stock</span>
                            }
                            @if (item.Price == bestPrice)
                            {
                                <span class="badge text-bg-primary ms-1">Best Price</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Product List</a>
</div>
