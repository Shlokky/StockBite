@model IEnumerable<StockBite.Models.VendorProduct>

@{
    ViewData["Title"] = "Vendor Products";
}

<h1>Vendor Products</h1>

<p>
    <a asp-action="Create">Create New Vendor-Product Relationship</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Vendor.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Product.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Price)</th>
            <th>@Html.DisplayNameFor(model => model.Quantity)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Vendor.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Price)</td>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>
                    @* Add edit/delete links if needed in future *@
                </td>
            </tr>
        }
    </tbody>
</table>
