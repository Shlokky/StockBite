@model IEnumerable<StockBite.Models.VendorProduct>

@{
    ViewData["Title"] = "Vendor Products";
    var relationships = Model ?? Enumerable.Empty<StockBite.Models.VendorProduct>();
    var relationCount = relationships.Count();
    var grouped = relationships
        .OrderBy(vp => vp.Vendor.Name)
        .ThenBy(vp => vp.Product.Name)
        .GroupBy(vp => vp.Vendor.Name)
        .ToList();
}

<div class="page-header">
    <div>
        <h1 class="page-title">Vendor-Product Relationships</h1>
        <p class="page-subtitle">Manage vendor prices and available stock per product.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm">Create New Relationship</a>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-label">Active Links</div>
        <div class="metric-value">@relationCount</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Section</div>
        <div class="metric-value">Pricing</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Mode</div>
        <div class="metric-value">Admin</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Action</div>
        <div class="metric-value">Create</div>
    </div>
</div>

@foreach (var vendorGroup in grouped)
{
    <div class="card app-card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@vendorGroup.Key</strong>
            <span class="badge text-bg-light border">@vendorGroup.Count() product(s)</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in vendorGroup)
                    {
                        <tr>
                            <td>@item.Product.Name</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>
                                @if (item.Quantity > 0)
                                {
                                    <span class="badge text-bg-success">@item.Quantity</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">0</span>
                                }
                            </td>
                            <td>
                                <form asp-action="Delete" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this relationship?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!relationships.Any())
{
    <div class="alert alert-info mt-3">No vendor-product links found. Create one to start comparisons.</div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3" role="alert">
        @TempData["SuccessMessage"]
    </div>
}
