@model StockBite.ViewModels.CartViewModel

@{
    ViewData["Title"] = "Cart";
}

<h1>Cart</h1>

@if (Model.Lines.Count == 0)
{
    <p>Your cart is empty.</p>
    <a asp-action="Index" class="btn btn-link">Back to Products</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Vendor</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Line Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.ProductName</td>
                    <td>@line.VendorName</td>
                    <td>@line.UnitPrice</td>
                    <td>
                        <form asp-action="UpdateCart" method="post" class="d-flex gap-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="vendorProductId" value="@line.VendorProductId" />
                            <input type="number" name="quantity" min="0" value="@line.Quantity" class="form-control form-control-sm" style="width: 100px;" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Update</button>
                        </form>
                    </td>
                    <td>@line.LineTotal</td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <strong>Total: @Model.Total</strong>
        <form asp-action="Checkout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Checkout</button>
        </form>
    </div>
    <a asp-action="Index" class="btn btn-link mt-2">Continue Shopping</a>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-3" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        const connection = new signalR.HubConnectionBuilder().withUrl("/stockHub").build();
        connection.on("inventoryUpdated", () => location.reload());
        connection.start().catch(err => console.error(err));
    </script>
}

