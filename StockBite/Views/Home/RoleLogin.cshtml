@using StockBite.Models
@{
    ViewData["Title"] = "Login";
    var selectedRole = ViewBag.SelectedRole is UserRole role ? role : UserRole.Public;
    var title = selectedRole == UserRole.Admin ? "Admin Login" : "Stock Manager Login";
    var description = selectedRole == UserRole.Admin
        ? "Use the project password to open the admin dashboard."
        : "Use the project password to continue to the stock manager dashboard.";
    var buttonClass = selectedRole == UserRole.Admin ? "btn-primary" : "btn-success";
}

<div class="login-page">
    <div class="login-card app-card">
        <div class="login-card-copy">
            <span class="landing-tag">Role Access</span>
            <h1 class="mt-3">@title</h1>
            <p class="text-muted mb-4">@description</p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    @TempData["ErrorMessage"]
                </div>
            }

            <form asp-controller="Home" asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="@selectedRole" />
                <div class="mb-3">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Enter password" required />
                </div>

                <button type="submit" class="btn @buttonClass w-100">Continue</button>
            </form>

            <div class="mt-3 text-center">
                <a asp-controller="Home" asp-action="Index" class="simple-link">Back to Home</a>
            </div>
        </div>
    </div>
</div>
