@{
    ViewData["Title"] = "StockBite";
}

<section class="landing-hero mb-4">
    <div class="row align-items-center g-4">
        <div class="col-lg-8">
            <span class="landing-tag">Final Semester Project</span>
            <h1 class="landing-title mt-3">StockBite is a smart stock and supply website for restaurants.</h1>
            <p class="landing-copy">
                StockBite is a simple web project made to help restaurants handle inventory, ordering, and vendor comparison
                in one place. Instead of managing stock manually, users can work through one clear website.
            </p>
            <p class="landing-copy-secondary mb-0">
                It is designed for admins, stock managers, and consumers, and the goal of the project is to make stock flow
                easier, faster, and more organized.
            </p>
        </div>
        <div class="col-lg-4">
            <div class="landing-highlight">
                <p class="highlight-label">Project Motto</p>
                <h2 class="h3">Smarter stock. Better supply. Less confusion.</h2>
                <p class="mb-0">
                    This project focuses on making daily stock work simple enough for real use and clear enough for presentation.
                </p>
            </div>        </div>
    </div>
</section>

<section class="landing-story app-card p-4 p-md-5 mb-4">
    <div class="row g-4">
        <div class="col-lg-6">
            <p class="landing-section-label">What Is The Project?</p>
            <h2 class="landing-section-title">A student-built platform for restaurant stock management.</h2>
            <p class="landing-section-copy mb-0">
                The main purpose of StockBite is to bring product tracking, vendor comparison, and ordering into one website
                so restaurant work becomes easier to manage.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="landing-glass-panel">
                <p class="landing-section-label">Who Is It For?</p>
                <p class="landing-section-copy mb-3">
                    This project is for admins, stock managers, and consumers who all need different access inside the same system.
                </p>
                <p class="landing-section-label">Why Was It Made?</p>
                <p class="landing-section-copy mb-0">
                    It was made to reduce manual stock work and make the ordering process more organized, visible, and easy to explain.
                </p>
            </div>
        </div>
    </div>
</section>
