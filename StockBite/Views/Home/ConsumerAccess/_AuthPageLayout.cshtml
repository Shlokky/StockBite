@model StockBite.ViewModels.ConsumerAccessViewModel

@{
    var isSignUpPage = string.Equals(ViewData["ConsumerAuthMode"] as string, "SignUp", StringComparison.OrdinalIgnoreCase);
    var showVerification = ViewData["ConsumerAuthShowVerification"] is bool verificationValue && verificationValue;
    var showLoginCode = ViewData["ConsumerAuthShowCode"] is bool loginCodeValue && loginCodeValue;
    var googleEnabled = ViewBag.GoogleEnabled is bool googleValue && googleValue;
    var pageTitle = isSignUpPage
        ? (showVerification ? "Verify your account" : "Create your StockBite account")
        : (showLoginCode ? "Enter your login code" : "Sign in to StockBite");
    var pageCopy = isSignUpPage
        ? (showVerification
            ? "We already sent the verification code to your email. Enter it below to finish your account."
            : "Create your account here. After you submit, StockBite will send the verification code automatically.")
        : (showLoginCode
            ? "We already sent the login code to your email. Enter it below to continue."
            : "Enter your email to continue. StockBite will send your login code automatically.");
}

<div class="consumer-auth-page">
    <section class="consumer-auth-intro">
        <span class="consumer-auth-tag">Consumer Access</span>
        <h1 class="consumer-auth-title">@pageTitle</h1>
        <p class="consumer-auth-copy">@pageCopy</p>

        <div class="consumer-auth-note">
            <h2>Fresh ingredients, simpler ordering</h2>
            <p>
                StockBite helps customers place orders faster, keep track of their purchases, and return anytime with a smooth sign-in experience.
            </p>
        </div>

        <div class="consumer-auth-note">
            <h2>Why customers use StockBite</h2>
            <p>Quick access to fresh stock, easy account verification, and a simple way to manage repeat orders in one place.</p>
        </div>
    </section>

    <section class="consumer-auth-panel">
        <div class="consumer-auth-card app-card">
            <partial name="ConsumerAccess/_AuthHeader" model="isSignUpPage" />
            <partial name="ConsumerAccess/_Alerts" />

            @if (isSignUpPage)
            {
                <div class="consumer-auth-section">
                    @if (showVerification)
                    {
                        <partial name="ConsumerAccess/_VerifyEmailForm" model="Model" />
                    }
                    else
                    {
                        <partial name="ConsumerAccess/_EmailSignUpForm" model="Model" />
                    }
                </div>
            }
            else
            {
                <div class="consumer-auth-section">
                    @if (showLoginCode)
                    {
                        <partial name="ConsumerAccess/_EmailLoginForm" model="Model" />
                    }
                    else
                    {
                        <partial name="ConsumerAccess/_StartEmailLoginForm" model="Model" />
                    }
                </div>

                @if (!showLoginCode)
                {
                    <div class="consumer-auth-divider">
                        <span>Other options</span>
                    </div>

                    <div class="consumer-auth-section">
                        <partial name="ConsumerAccess/_ExternalLoginPanel" model="googleEnabled" />
                    </div>

                    <div class="consumer-auth-section">
                        <partial name="ConsumerAccess/_GuestAccessPanel" />
                    </div>
                }
            }
        </div>
    </section>
</div>
