@model StockBite.Models.VendorComparisonVM

<h2>Compare Vendors for @Model.ProductName</h2>

<table class="table">
    <thead>
        <tr>
            <th>Vendor</th>
            <th>Price</th>
            <th>Available Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var v in Model.VendorOptions)
        {
            <tr>
                <td>@v.Vendor.Name</td>
                <td>@v.Price</td>
                <td>@v.AvailableQuantity</td>
            </tr>
        }
    </tbody>
</table>
