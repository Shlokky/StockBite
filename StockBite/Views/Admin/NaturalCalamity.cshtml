@{
    ViewData["Title"] = "Trigger Natural Calamity";
}

<h1 class="mb-2">Trigger Natural Calamity</h1>
<p class="text-muted">Select a product to simulate market disruption and price impact.</p>

<div class="row justify-content-start">
    <div class="col-md-7 col-lg-5">
        <div class="card app-card">
            <div class="card-body">
                <form asp-action="NaturalCalamity" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="mb-3">
                        <label for="productId" class="form-label">Select Product</label>
                        <select id="productId" name="productId" class="form-select" asp-items="@(ViewData["ProductId"] as SelectList)"></select>
                    </div>
                    <div class="d-flex gap-2">
                        <input type="submit" value="Trigger Calamity" class="btn btn-danger" />
                        <a asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
