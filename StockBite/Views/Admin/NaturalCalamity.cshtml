@{
    ViewData["Title"] = "Trigger Natural Calamity";
}

<h1>Trigger Natural Calamity</h1>

<p>Select a product to simulate a natural disaster affecting its supply.</p>

<div class="row">
    <div class="col-md-4">
        <form asp-action="NaturalCalamity" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label for="productId" class="control-label">Select Product</label>
                <select id="productId" name="productId" class="form-control" asp-items="@(ViewData["ProductId"] as SelectList)"></select>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Trigger Calamity" class="btn btn-danger" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Dashboard">Back to Admin Dashboard</a>
</div>