@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-md-4">
        <h2>Product Management</h2>
        <ul>
            <li><a asp-controller="Products" asp-action="Index">View All Products</a></li>
            <li><a asp-controller="Products" asp-action="Create">Add New Product</a></li>
        </ul>
    </div>
    <div class="col-md-4">
        <h2>Vendor Management</h2>
        <ul>
            <li><a asp-controller="AdminVendors" asp-action="Index">View All Vendors</a></li>
            <li><a asp-controller="AdminVendors" asp-action="Create">Add New Vendor</a></li>
        </ul>
    </div>
    <div class="col-md-4">
        <h2>Vendor-Product Relationships</h2>
        <ul>
            <li><a asp-controller="VendorProducts" asp-action="Index">View Vendor-Product Links</a></li>
            <li><a asp-controller="VendorProducts" asp-action="Create">Create Vendor-Product Link</a></li>
        </ul>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <h2>System Orders</h2>
        <ul>
            <li><a asp-controller="Orders" asp-action="Index">View All Orders</a></li>
        </ul>
    </div>
    <div class="col-md-4">
        <h2>Simulation</h2>
        <ul>
            <li><a asp-controller="Admin" asp-action="NaturalCalamity">Trigger Natural Calamity</a></li>
        </ul>
    </div>
</div>