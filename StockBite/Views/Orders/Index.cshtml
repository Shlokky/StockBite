@model IEnumerable<StockBite.Models.Order>

@{
    ViewData["Title"] = "Orders";
    var totalOrders = Model?.Count() ?? 0;
    var pendingOrders = Model?.Count(o => o.Status == StockBite.Models.OrderStatus.Pending) ?? 0;
}

<div class="page-header">
    <div>
        <h1 class="page-title">All Orders</h1>
        <p class="page-subtitle">Monitor order history, status, and approvals.</p>
    </div>
    <span class="badge text-bg-dark px-3 py-2">Admin View</span>
</div>

<div class="metrics-grid">
    <div class="metric-card">
        <div class="metric-label">Total Orders</div>
        <div class="metric-value">@totalOrders</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Pending</div>
        <div class="metric-value">@pendingOrders</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Section</div>
        <div class="metric-value">Orders</div>
    </div>
    <div class="metric-card">
        <div class="metric-label">Scope</div>
        <div class="metric-value">System</div>
    </div>
</div>

<div class="card app-card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead>
                <tr>
                    <th>Consumer</th>
                    <th>Placed By</th>
                    <th>Delivery</th>
                    <th>Payment</th>
                    <th>@Html.DisplayNameFor(model => model.Product.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Vendor.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.Quantity)</th>
                    <th>@Html.DisplayNameFor(model => model.TotalPrice)</th>
                    <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
                    <th>Status</th>
                    <th>Approved</th>
                    <th>Delivered</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Consumer.Name</td>
                        <td>@item.CustomerName</td>
                        <td>@item.DeliveryAddress</td>
                        <td>@item.PaymentMethod</td>
                        <td>@Html.DisplayFor(modelItem => item.Product.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Vendor.Name)</td>
                        <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                        <td>@item.TotalPrice.ToString("C")</td>
                        <td>@item.OrderDate.ToString("g")</td>
                        <td>
                            @if (item.Status == StockBite.Models.OrderStatus.Pending)
                            {
                                <span class="badge text-bg-warning">Pending</span>
                            }
                            else if (item.Status == StockBite.Models.OrderStatus.Approved)
                            {
                                <span class="badge text-bg-success">Approved</span>
                            }
                            else if (item.Status == StockBite.Models.OrderStatus.Delivered)
                            {
                                <span class="badge text-bg-primary">Delivered</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">@item.Status</span>
                            }
                        </td>
                        <td>@(item.ApprovedAt?.ToString("g") ?? "-")</td>
                        <td>@(item.DeliveredAt?.ToString("g") ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info mt-3">No orders found yet.</div>
}
